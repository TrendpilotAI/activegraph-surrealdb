{"id":"int-85fd97304a7a9b0426f05184de93aaf8","kind":"tool_call","created_at":"2026-10-13T02:46:20.091Z","actor":"TrendpilotAI","tool_name":"write","extra":{"call_id":"chatcmpl-tool-98240c112d0d11e1","exit":null,"input":"{\"path\": \"/work/.mercor-home/checkpoint_transcript.py\", \"content\": \"\\\"\\\"\\\"Checkpoint: mirror this OpenCode session into the beads audit stream.\\n\\nMirrors tools/opencode/beads-audit.ts schema/clipping for sessions the\\nplugin did not capture (plugin stream stopped at 02:01 today).\\n\\\"\\\"\\\"\\nimport json\\nimport sqlite3\\nimport subprocess\\nimport sys\\nfrom datetime import datetime, timezone\\n\\nSESSION_ID = \\\"ses_ecce71390ffe11p6yPgte61c3p\\\"\\nDB = \\\"/home/mercor/.local/share/opencode/opencode.db\\\"\\nBD = \\\"/home/mercor/.local/bin/bd\\\"\\nACTOR = \\\"TrendpilotAI\\\"\\nSOURCE = \\\"opencode-checkpoint-script\\\"\\nTEXT_CLIP = 200_000\\nTOOL_CLIP = 20_000\\n\\n\\ndef clip(value, max_len):\\n    if value is None:\\n        return \\\"\\\"\\n    text = value if isinstance(value, str) else json.dumps(value, default=str)\\n    if len(text) > max_len:\\n        return text[:max_len] + f\\\"\\u2026[truncated {len(text) - max_len} chars]\\\"\\n    return text\\n\\n\\ndef iso(ms):\\n    return datetime.fromtimestamp(ms / 1000, tz=timezone.utc).isoformat()\\n\\n\\ndef record(entry):\\n    payload = {\\\"actor\\\": ACTOR, \\\"created_at\\\": iso(entry.pop(\\\"created_ms\\\")), **entry}\\n    proc = subprocess.run(\\n        [BD, \\\"audit\\\", \\\"record\\\", \\\"--stdin\\\", \\\"--quiet\\\"],\\n        input=json.dumps(payload), capture_output=True, text=True, cwd=\\\"/work/mercor-work/activegraph-surrealdb\\\",\\n    )\\n    if proc.returncode != 0:\\n        print(\\\"record failed:\\\", proc.stderr[:200], file=sys.stderr)\\n    return proc.returncode\\n\\n\\ndb = sqlite3.connect(f\\\"file:{DB}?mode=ro\\\", uri=True)\\nrows = db.execute(\\n    \\\"SELECT type, data, time_created FROM session_message \\\"\\n    \\\"WHERE session_id = ? ORDER BY seq\\\", (SESSION_ID,),\\n).fetchall()\\n\\ncounts = {\\\"user_turn\\\": 0, \\\"llm_call\\\": 0, \\\"tool_call\\\": 0}\\nfor type_, data, ts in rows:\\n    j = json.loads(data)\\n    if type_ == \\\"user\\\":\\n        counts[\\\"user_turn\\\"] += 1\\n        record({\\n            \\\"created_ms\\\": j.get(\\\"time\\\", {}).get(\\\"created\\\", ts),\\n            \\\"kind\\\": \\\"user_turn\\\",\\n            \\\"prompt\\\": clip(j.get(\\\"text\\\"), TEXT_CLIP),\\n            \\\"extra\\\": {\\\"session_id\\\": SESSION_ID, \\\"source\\\": SOURCE,\\n                      \\\"files\\\": [f.get(\\\"uri\\\") for f in (j.get(\\\"files\\\") or []) if isinstance(f, dict)]},\\n        })\\n    elif type_ == \\\"assistant\\\":\\n        info = j\\n        created = info.get(\\\"time\\\", {}).get(\\\"created\\\", ts)\\n        text = \\\"\\\".join(\\n            c.get(\\\"text\\\", \\\"\\\") for c in info.get(\\\"content\\\", [])\\n            if isinstance(c, dict) and c.get(\\\"type\\\") == \\\"text\\\"\\n        )\\n        model = info.get(\\\"model\\\") or {}\\n        counts[\\\"llm_call\\\"] += 1\\n        record({\\n            \\\"created_ms\\\": created,\\n            \\\"kind\\\": \\\"llm_call\\\",\\n            \\\"model\\\": f\\\"{model.get('providerID', '?')}/{model.get('id', '?')}\\\"\\n                     + (f\\\"#{model['variant']}\\\" if model.get(\\\"variant\\\") else \\\"\\\"),\\n            \\\"response\\\": clip(text, TEXT_CLIP),\\n            \\\"extra\\\": {\\\"session_id\\\": SESSION_ID, \\\"source\\\": SOURCE,\\n                      \\\"agent\\\": info.get(\\\"agent\\\"), \\\"tokens\\\": info.get(\\\"tokens\\\"),\\n                      \\\"cost\\\": info.get(\\\"cost\\\"), \\\"time\\\": info.get(\\\"time\\\")},\\n        })\\n        for c in info.get(\\\"content\\\", []):\\n            if not (isinstance(c, dict) and c.get(\\\"type\\\") == \\\"tool\\\"):\\n                continue\\n            state = c.get(\\\"state\\\") or {}\\n            meta = state.get(\\\"metadata\\\") or {}\\n            counts[\\\"tool_call\\\"] += 1\\n            record({\\n                \\\"created_ms\\\": (c.get(\\\"time\\\") or {}).get(\\\"created\\\", created),\\n                \\\"kind\\\": \\\"tool_call\\\",\\n                \\\"tool_name\\\": str(c.get(\\\"name\\\", \\\"unknown\\\")),\\n                \\\"error\\\": None if state.get(\\\"status\\\") == \\\"completed\\\" else clip(state.get(\\\"status\\\"), 4000),\\n                \\\"extra\\\": {\\\"session_id\\\": SESSION_ID, \\\"source\\\": SOURCE,\\n                          \\\"call_id\\\": c.get(\\\"id\\\"),\\n                          \\\"status\\\": state.get(\\\"status\\\"),\\n                          \\\"input\\\": clip(state.get(\\\"input\\\"), TOOL_CLIP),\\n                          \\\"result\\\": clip(\\n                              \\\"\\\".join(p.get(\\\"text\\\", \\\"\\\") for p in state.get(\\\"content\\\", [])\\n                                      if isinstance(p, dict) and p.get(\\\"type\\\") == \\\"text\\\"),\\n                              TOOL_CLIP),\\n                          \\\"exit\\\": meta.get(\\\"exit\\\")},\\n            })\\n\\nprint(\\\"recorded:\\\", counts)\\n\"}","result":"Created file successfully: /work/.mercor-home/checkpoint_transcript.py","session_id":"ses_ecce71390ffe11p6yPgte61c3p","source":"opencode-checkpoint-script","status":"completed"}}
