{"id":"int-475be37ce326994089dcb6dddebd5f16","kind":"tool_call","created_at":"2026-10-13T03:05:47.409Z","actor":"opencode","tool_name":"read","extra":{"call_id":"chatcmpl-tool-b7cab600e0c46cf2","duration_ms":37,"input":"{\"path\":\"/work/mercor-work/activegraph-surrealdb/tests/embedded/test_embedded_lane.py\"}","message_id":"msg_133391f45001Zpz9WDtiA1qmli","result":"{\"output\":{\"type\":\"file\",\"uri\":\"file:///work/mercor-work/activegraph-surrealdb/tests/embedded/test_embedded_lane.py\",\"name\":\"test_embedded_lane.py\",\"content\":\"\\\"\\\"\\\"Embedded SDK lane: expected-rejection evidence.\\n\\nThe preview's proven transport contract is WebSocket only: the provider pins\\n``surrealdb==2.0.0`` (plain ``ws://`` / ``wss://``) and ``SurrealConfig``\\nrejects every embedded/local transport scheme up front. This lane installs\\nthe upstream embedded SDK variant (``surrealdb[embedded]==3.0.0b10``) in an\\nisolated venv and asserts that the provider still rejects embedded\\ntransports — the contract-first posture: upstream limitations are recorded,\\nnot patched, and an unproven SDK variant cannot silently widen the accepted\\ntransports.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\n\\nimport pytest\\n\\nfrom activegraph_surrealdb import SurrealConfig\\nfrom activegraph_surrealdb.errors import ConfigurationError\\n\\npytestmark = pytest.mark.embedded\\n\\n\\ndef _gate_enabled() -> bool:\\n    return os.getenv(\\\"ACTIVEGRAPH_SURREALDB_EMBEDDED\\\") == \\\"1\\\"\\n\\n\\ndef test_embedded_sdk_variant_is_installed() -> None:\\n    \\\"\\\"\\\"The isolated lane venv really carries the embedded SDK variant.\\\"\\\"\\\"\\n    try:\\n        from importlib.metadata import version\\n\\n        import surrealdb  # noqa: F401\\n\\n        sdk_version = version(\\\"surrealdb\\\")\\n    except Exception as exc:  # pragma: no cover - environment guard\\n        pytest.fail(f\\\"embedded venv must have the surrealdb SDK importable: {exc}\\\")\\n    assert sdk_version.startswith(\\\"3.0.0\\\"), (\\n        f\\\"expected the surrealdb[embedded] 3.0.0b10 variant, got {sdk_version}\\\"\\n    )\\n\\n\\n@pytest.mark.parametrize(\\n    \\\"endpoint\\\",\\n    [\\n        \\\"mem://\\\",\\n        \\\"file:///tmp/provider.db\\\",\\n        \\\"surrealkv:///tmp/provider.db\\\",\\n        \\\"rocksdb:///tmp/provider.db\\\",\\n    ],\\n)\\ndef test_embedded_transports_stay_rejected(endpoint: str) -> None:\\n    \\\"\\\"\\\"Embedded transports are rejected even with the embedded SDK installed.\\\"\\\"\\\"\\n    with pytest.raises(ConfigurationError, match=\\\"ws:// or wss://\\\"):\\n        SurrealConfig(\\n            endpoint=endpoint,\\n            namespace=\\\"activegraph\\\",\\n            database=\\\"provider\\\",\\n            username=\\\"service\\\",\\n            password=\\\"secret\\\",\\n        )\\n\",\"encoding\":\"utf8\",\"mime\":\"application/octet-stream\"},\"content\":[{\"type\":\"text\",\"text\":\"Read file /work/mercor-work/activegraph-surrealdb/tests/embedded/test_embedded_lane.py, lines 1-62\\n1: \\\"\\\"\\\"Embedded SDK lane: expected-rejection evidence.\\n2: \\n3: The preview's proven transport contract is WebSocket only: the provider pins\\n4: ``surrealdb==2.0.0`` (plain ``ws://`` / ``wss://``) and ``SurrealConfig``\\n5: rejects every embedded/local transport scheme up front. This lane installs\\n6: the upstream embedded SDK variant (``surrealdb[embedded]==3.0.0b10``) in an\\n7: isolated venv and asserts that the provider still rejects embedded\\n8: transports — the contract-first posture: upstream limitations are recorded,\\n9: not patched, and an unproven SDK variant cannot silently widen the accepted\\n10: transports.\\n11: \\\"\\\"\\\"\\n12: \\n13: from __future__ import annotations\\n14: \\n15: import os\\n16: \\n17: import pytest\\n18: \\n19: from activegraph_surrealdb import SurrealConfig\\n20: from activegraph_surrealdb.errors import ConfigurationError\\n21: \\n22: pytestmark = pytest.mark.embedded\\n23: \\n24: \\n25: def _gate_enabled() -> bool:\\n26:     return os.getenv(\\\"ACTIVEGRAPH_SURREALDB_EMBEDDED\\\") == \\\"1\\\"\\n27: \\n28: \\n29: def test_embedded_sdk_variant_is_installed() -> None:\\n30:     \\\"\\\"\\\"The isolated lane venv really carries the embedded SDK variant.\\\"\\\"\\\"\\n31:     try:\\n32:         from importlib.metadata import version\\n33: \\n34:         import surrealdb  # noqa: F401\\n35: \\n36:         sdk_version = version(\\\"surrealdb\\\")\\n37:     except Exception as exc:  # pragma: no cover - environment guard\\n38:         pytest.fail(f\\\"embedded venv must have the surrealdb SDK importable: {exc}\\\")\\n39:     assert sdk_version.startswith(\\\"3.0.0\\\"), (\\n40:         f\\\"expected the surrealdb[embedded] 3.0.0b10 variant, got {sdk_version}\\\"\\n41:     )\\n42: \\n43: \\n44: @pytest.mark.parametrize(\\n45:     \\\"endpoint\\\",\\n46:     [\\n47:         \\\"mem://\\\",\\n48:         \\\"file:///tmp/provider.db\\\",\\n49:         \\\"surrealkv:///tmp/provider.db\\\",\\n50:         \\\"rocksdb:///tmp/provider.db\\\",\\n51:     ],\\n52: )\\n53: def test_embedded_transports_stay_rejected(endpoint: str) -> None:\\n54:     \\\"\\\"\\\"Embedded transports are rejected even with the embedded SDK installed.\\\"\\\"\\\"\\n55:     with pytest.raises(ConfigurationError, match=\\\"ws:// or wss://\\\"):\\n56:         SurrealConfig(\\n57:             endpoint=endpoint,\\n58:             namespace=\\\"activegraph\\\",\\n59:             database=\\\"provider\\\",\\n60:             username=\\\"service\\\",\\n61:             password=\\\"secret\\\",\\n62:         )\"}],\"metadata\":{\"truncated\":false}}","session_id":"ses_ecce71390ffe11p6yPgte61c3p","status":"completed"}}
