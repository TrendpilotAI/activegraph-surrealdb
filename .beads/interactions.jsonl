i.js sibling (md5 unchanged).\\\" \\\\\\n  --notes \\\"Three other workspaces (run ids 4da1bb06, 502e2132, 797c5df9, ecfb849d) reported the same root cause; the global fix at ~/.config/opencode/plugins outlives any single workspace. The codification in this repo (ADR + script) is the durable artifact for future plugin authors.\\\" 2>&1 | tail -30\",\"timeout\":15000}","message_id":"msg_1333a98aa001RHSlv1dZ5k28v6","result":"{\"output\":{\"exit\":0,\"truncated\":false,\"output\":\"✓ Created issue: agvm-76z — Resolve orca-opencode2-status plugin load failure (err_97f42f88) and codify the OpenCode 2 directory-package layout\\n  Priority: P2\\n  Status: open\\n\",\"status\":\"completed\"},\"content\":[{\"type\":\"text\",\"text\":\"✓ Created issue: agvm-76z — Resolve orca-opencode2-status plugin load failure (err_97f42f88) and codify the OpenCode 2 directory-package layout\\n  Priority: P2\\n  Status: open\\n\"}],\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0}}","session_id":"ses_eccd12d4cffe3Dd6d2N0q7gQQs","status":"completed"}}
