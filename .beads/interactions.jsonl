t upgraded_events.verify_integrity() == expected_integrity\\n250:         assert upgraded_events.schema_version() == \\\"1\\\"\\n251:         surviving = sorted(\\n252:             (obj.id, obj.type, obj.data) for obj in upgraded_projection.all_objects()\\n253:         )\\n254:         assert surviving == expected_objects\\n255: \\n256:         # The projection is disposable: clear it, then replay the migrated log.\\n257:         upgraded_projection.clear()\\n258:         assert upgraded_projection.all_objects() == []\\n259:         replayed = replay_graph(upgraded_events, upgraded_projection)\\n260:         replayed_objects = sorted((obj.id, obj.type, obj.data) for obj in replayed.all_objects())\\n261:         assert replayed_objects == expected_objects\\n262:         assert upgraded_projection.projection_status() == \\\"ready\\\"\\n263:         upgraded_events.close()\\n264:         upgraded_projection.close()\\n265: \\n266:         # Phase 4: restore the export into a fresh 3.2.4 datastore (rollback rehearsal).\\n267:         _create_fresh_volume(restore_volume)\\n268:         restore_config = _start_server(\\n269:             LEGACY_IMAGE,\\n270:             restore_container,\\n271:             restore_volume,\\n272:             environment.config,\\n273:             timeout_seconds=LEGACY_START_TIMEOUT_SECONDS,\\n274:         )\\n275:         _import_export(restore_container, export_path, restore_config)\\n276:         restored_events = SurrealEventStore(restore_config, run_id=run_id, scope=scope)\\n277:         assert restored_events.server_version() == \\\"3.2.4\\\"\\n278:         assert [event.id for event in restored_events.iter_events()] == expected_event_ids\\n279:         assert restored_events.verify_integrity() == expected_integrity\\n280:         assert restored_events.schema_version() == \\\"1\\\"\\n281:         restored_events.close()\\n282:     finally:\\n283:         _discard(container, volume)\\n284:         _discard(restore_container, restore_v