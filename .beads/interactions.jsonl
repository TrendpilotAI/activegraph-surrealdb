n#   $PLUGINS_DIR/$PLUGIN_NAME/index.$EXT\\nTARGET_DIR=\\\"$PLUGINS_DIR/$PLUGIN_NAME\\\"\\nTARGET_FILE=\\\"$TARGET_DIR/index.$EXT\\\"\\n\\n# What the legacy / unwanted shape looks like:\\n#   $PLUGINS_DIR/$PLUGIN_NAME.$EXT  (single-file, will fail OpenCode 2)\\nLEGACY_FILE=\\\"$PLUGINS_DIR/$PLUGIN_NAME.$EXT\\\"\\n\\nrun() {\\n  if [ \\\"$DRY_RUN\\\" = \\\"1\\\" ]; then\\n    echo \\\"[dry-run] $*\\\"\\n  else\\n    \\\"$@\\\"\\n  fi\\n}\\n\\necho \\\"plugins-dir: $PLUGINS_DIR\\\"\\necho \\\"name:        $PLUGIN_NAME\\\"\\necho \\\"source:      $SOURCE_ABS\\\"\\necho \\\"target-dir:  $TARGET_DIR\\\"\\necho \\\"target-file: $TARGET_FILE\\\"\\necho \\\"legacy-file: $LEGACY_FILE\\\"\\n\\n# 1. Remove the legacy single-file layout if present. This is the file that\\n#    the OpenCode 2 loader still scans (and then fails on with ENOENT).\\nif [ -e \\\"$LEGACY_FILE\\\" ] && [ ! -d \\\"$LEGACY_FILE\\\" ]; then\\n  run mv \\\"$LEGACY_FILE\\\" \\\"$LEGACY_FILE.disabled-by-install-opencode-plugins.$(date -u +%Y%m%dT%H%M%SZ)\\\"\\nfi\\n\\n# 2. Make the directory package.\\nrun mkdir -p \\\"$TARGET_DIR\\\"\\n\\n# 3. Drop the entry file in.\\nrun cp \\\"$SOURCE_ABS\\\" \\\"$TARGET_FILE\\\"\\nrun chmod 0644 \\\"$TARGET_FILE\\\"\\n\\n# 4. Verify. node's statSync on the target must succeed and the file must\\n#    be readable. We do not import the plugin here; the loader will do its\\n#    own probe on the next reconciliation cycle.\\nif [ \\\"$DRY_RUN\\\" = \\\"0\\\" ]; then\\n  node -e \\\"\\n    const fs = require('fs');\\n    const st = fs.statSync(process.argv[1]);\\n    if (!st.isFile()) throw new Error('not a file');\\n    const bytes = fs.readFileSync(process.argv[1]);\\n    if (bytes.length === 0) throw new Error('empty file');\\n    console.log('verified:', process.argv[1], '(' + bytes.length + ' bytes)');\\n  \\\" \\\"$TARGET_FILE\\\"\\nfi\\n\\n# 5. Reminder. The loader does not re-scan plugins mid-run; reconciliation\\n#    happens on the next server event (config change, restart, periodic\\n#    trigger). If you need the plugin to be active in the current OpenCode\\n#    process, restart it after running this script.\\necho\\necho \\\"installed. Trigger a plugin reconciliation by restarting OpenCode\\\"\\necho \\\"or by editing ~/.config/opencode/opencode.json (a no-op edit suffices).\\\"\\n\"}","message_id":"msg_13339f1590011FUvu1ofOt4vCQ","result":"{\"output\":{\"operation\":\"write\",\"target\":\"/work/.mercor-home/orca/workspaces/activegraph-surrealdb/integration-activegraph-adaptor/scripts/install-opencode-plugins.sh\",\"resource\":\"scripts/install-opencode-plugins.sh\",\"existed\":false},\"content\":[{\"type\":\"text\",\"text\":\"Created file successfully: scripts/install-opencode-plugins.sh\"}]}","session_id":"ses_eccd12d4cffe3Dd6d2N0q7gQQs","status":"completed"}}
