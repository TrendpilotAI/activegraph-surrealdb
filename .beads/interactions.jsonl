rrealdb-tls}\\n    depends_on:\\n      volume-init:\\n        condition: service_completed_successfully\\n    environment:\\n      SURREAL_USER: ${SURREALDB_USER:-root}\\n      SURREAL_PASS: ${SURREALDB_PASSWORD:?set SURREALDB_PASSWORD in .env}\\n    command:\\n      - start\\n      - --bind\\n      - 0.0.0.0:8000\\n      - --log\\n      - ${SURREALDB_LOG:-info}\\n      - --web-crt\\n      - /tls/tls.crt\\n      - --web-key\\n      - /tls/tls.key\\n      - ${SURREALDB_ENGINE:-rocksdb}:///data/activegraph.db\\n    ports:\\n      - 127.0.0.1:${SURREALDB_PORT:-8000}:8000\\n    volumes:\\n      - type: volume\\n        source: surrealdb-data\\n        target: /data\\n        volume:\\n          nocopy: true\\n      - type: bind\\n        source: ${SURREALDB_WEB_CRT:-./tls/tls.crt}\\n        target: /tls/tls.crt\\n        read_only: true\\n        bind:\\n          create_host_path: false\\n      - type: bind\\n        source: ${SURREALDB_WEB_KEY:-./tls/tls.key}\\n        target: /tls/tls.key\\n        read_only: true\\n        bind:\\n          create_host_path: false\\n    healthcheck:\\n      test: [\\\"CMD\\\", \\\"/surreal\\\", \\\"is-ready\\\", \\\"--endpoint\\\", \\\"https://127.0.0.1:8000\\\"]\\n      interval: 2s\\n      timeout: 2s\\n      retries: 30\\n      start_period: 5s\\n    stop_grace_period: 30s\\n\\nvolumes:\\n  surrealdb-data:\\n    name: ${SURREALDB_VOLUME:-activegraph-surrealdb-data}\\n\",\"encoding\":\"utf8\",\"mime\":\"text/yaml\"},\"content\":[{\"type\":\"text\",\"text\":\"Read file /home/mercor/orca/workspaces/activegraph-surrealdb/mercor-vm/compose.yaml, lines 1-98\\n1: name: activegraph-surrealdb\\n2: \\n3: services:\\n4:   volume-init:\\n5:     image: busybox:1.37.0\\n6:     user: \\\"0:0\\\"\\n7:     command: [\\\"chmod\\\", \\\"0777\\\", \\\"/data\\\"]\\n8:     volumes:\\n9:       - type: volume\\n10:         source: surrealdb-data\\n11:         target: /data\\n12:         volume:\\n13:           nocopy: true\\n14: \\n15:   surrealdb:\\n16