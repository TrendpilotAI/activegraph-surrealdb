# Local-only SurrealDB server. Copy to .env; never commit the resulting file.
SURREALDB_CONTAINER_NAME=activegraph-surrealdb
SURREALDB_VOLUME=activegraph-surrealdb-data
SURREALDB_PORT=8000
SURREALDB_LOG=info
SURREALDB_USER=root
SURREALDB_PASSWORD=replace-with-a-local-development-password

# Integration-test connection. Keep the password equal to SURREALDB_PASSWORD.
ACTIVEGRAPH_SURREALDB_TEST_URL=ws://127.0.0.1:8000
ACTIVEGRAPH_SURREALDB_TEST_NAMESPACE=activegraph
ACTIVEGRAPH_SURREALDB_TEST_DATABASE=provider_test
ACTIVEGRAPH_SURREALDB_TEST_USERNAME=root
ACTIVEGRAPH_SURREALDB_TEST_PASSWORD=replace-with-a-local-development-password

# Qualification tests control the named container, including stopping it.
ACTIVEGRAPH_SURREALDB_QUALIFY=0
ACTIVEGRAPH_SURREALDB_DOCKER_CONTAINER=activegraph-surrealdb
ACTIVEGRAPH_SURREALDB_DOCKER_VOLUME=activegraph-surrealdb-data

# Optional Arize AX export of test telemetry and conformance evals
# (see docs/telemetry.md). Export runs only when ACTIVEGRAPH_SURREALDB_ARIZE=1
# AND both credentials are set. Metadata only; never graph or event payloads.
ACTIVEGRAPH_SURREALDB_ARIZE=0
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=activegraph-surrealdb
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1
